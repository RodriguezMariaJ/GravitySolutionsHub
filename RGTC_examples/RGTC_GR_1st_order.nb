Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Approximation", " ", "rules"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"approx", ",", "ApproxSimplify", ",", "ApproxFullSimplify"}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"convert", " ", "derivative", " ", "of", " ", "a", 
     RowBox[{"(", "t", ")"}], " ", "to", " ", "H", 
     RowBox[{"(", "t", ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"a2H", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"a", "'"}], "[", "\[Tau]", "]"}], "\[Rule]", 
        RowBox[{
         RowBox[{"H", "[", "\[Tau]", "]"}], " ", 
         RowBox[{"a", "[", "\[Tau]", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{
         SuperscriptBox["a", "\[Prime]\[Prime]",
          MultilineFunction->None], "[", "\[Tau]", "]"}], "\[Rule]", 
        RowBox[{
         RowBox[{"a", "[", "\[Tau]", "]"}], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"H", "'"}], "[", "\[Tau]", "]"}], "+", 
           RowBox[{
            RowBox[{"H", "[", "\[Tau]", "]"}], "^", "2"}]}], ")"}]}]}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"This", " ", "gives", " ", "the", " ", "zero", " ", "order"}], 
     " ", "=", " ", 
     RowBox[{"background", " ", "term"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"zeroorder", "=", 
     RowBox[{"{", 
      RowBox[{"\[Epsilon]", "\[Rule]", "0"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "The", " ", "following", " ", "two", " ", "convert", " ", "velocities", 
     " ", "to", " ", "\[Theta]"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetadef", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"kx", " ", 
         RowBox[{"ux", "[", 
          RowBox[{"\[Tau]", ",", "x", ",", "y", ",", "z"}], "]"}], "X_"}], 
        "+", 
        RowBox[{"ky", " ", 
         RowBox[{"uy", "[", 
          RowBox[{"\[Tau]", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
         "X_"}], "+", 
        RowBox[{"kz", " ", 
         RowBox[{"uz", "[", 
          RowBox[{"\[Tau]", ",", "x", ",", "y", ",", "z"}], "]"}], " ", 
         "X_"}]}], "\[Rule]", 
       RowBox[{"X", " ", 
        FractionBox[
         RowBox[{"\[Theta]", "[", 
          RowBox[{"\[Tau]", ",", "x", ",", "y", ",", "z"}], "]"}], "I"]}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"thetadef1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"kx", " ", 
         RowBox[{
          SuperscriptBox["ux", 
           TagBox[
            RowBox[{"(", 
             RowBox[{"1", ",", "0", ",", "0", ",", "0"}], ")"}],
            Derivative],
