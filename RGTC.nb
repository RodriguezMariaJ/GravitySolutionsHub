        RowBox[{"-", "2"}], " ", "M", " ", "r"}], "+", 
       SuperscriptBox["r", "2"], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["x", "2"]}]}], ")"}]}], ")"}]}]}]], "Output"]
}, Open  ]],

