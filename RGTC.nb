Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"d", "[", "t", "]"}], ",", "dr", ",", 
   InterpretationBox[
    RowBox[{
     RowBox[{"r", " ", 
      RowBox[{"d", "[", "\[Theta]", "]"}]}], "-", 
     RowBox[{
      RowBox[{"d", "[", "\[Theta]", "]"}], " ", "b"}], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"d", "[", "\[Theta]", "]"}], " ", 
       SuperscriptBox["b", "2"]}], 
      RowBox[{"2", " ", "r"}]], "-", 
     FractionBox[
      RowBox[{
       RowBox[{"d", "[", "\[Theta]", "]"}], " ", 
       SuperscriptBox["b", "3"]}], 
      RowBox[{"6", " ", 
       SuperscriptBox["r", "2"]}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"d", "[", "\[Theta]", "]"}], " ", 
       SuperscriptBox["b", "4"]}], 
      RowBox[{"24", " ", 
       SuperscriptBox["r", "3"]}]], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 0, 5, 1]]}],
    SeriesData[
    b, 0, {r d[\[Theta]], -d[\[Theta]], Rational[1, 2] r^(-1) d[\[Theta]], 
      Rational[-1, 6] r^(-2) d[\[Theta]], Rational[1, 24] r^(-3) d[\[Theta]]},
      0, 5, 1]], ",", 
   InterpretationBox[
    RowBox[{
     RowBox[{"r", " ", 
      RowBox[{"d", "[", "\[CurlyPhi]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}]}], "+", 
     RowBox[{
      RowBox[{"d", "[", "\[CurlyPhi]", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", "b"}], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       SuperscriptBox["b", "2"]}], 
      RowBox[{"2", " ", "r"}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       SuperscriptBox["b", "3"]}], 
      RowBox[{"6", " ", 
       SuperscriptBox["r", "2"]}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
       SuperscriptBox["b", "4"]}], 
      RowBox[{"24", " ", 
       SuperscriptBox["r", "3"]}]], "+", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 0, 5, 1]]}],
    SeriesData[
    b, 0, {r d[\[CurlyPhi]] Sin[\[Theta]], d[\[CurlyPhi]] Sin[\[Theta]], 
      Rational[1, 2] r^(-1) d[\[CurlyPhi]] Sin[\[Theta]], Rational[1, 6] 
      r^(-2) d[\[CurlyPhi]] Sin[\[Theta]], Rational[1, 24] r^(-3) 
      d[\[CurlyPhi]] Sin[\[Theta]]}, 0, 5, 1]]}], "}"}]], "Output"]
