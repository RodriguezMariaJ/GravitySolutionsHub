        RowBox[{"r", "+", "t"}], "]"}]}], ")"}], "/", "r"}]}], "]"}],
  FontFamily->"Courier",
  FontWeight->"Bold"]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
