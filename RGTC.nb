          RowBox[{"(", 
           FractionBox["1", "r"], ")"}], "2"]]}], "+", 
       FractionBox[
        RowBox[{"2", " ", "b"}], 
        FractionBox["1", "r"]], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["b", "2"]}], "+", 
       FractionBox[
        RowBox[{"4", " ", 
