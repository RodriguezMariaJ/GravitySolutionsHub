    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", "r"], ")"}], "3"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      FractionBox["1", "r"], "]"}], "4"],
    SeriesData[r, 
     DirectedInfinity[1], {}, -2, 4, 1]]}],
  SeriesData[r, 
   DirectedInfinity[
