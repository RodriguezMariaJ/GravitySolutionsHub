    2 b (\[ScriptD][\[Theta]] - 
     Sin[\[Theta]] \[ScriptD][\[CurlyPhi]]) (\[ScriptD][\[Theta]] + 
     Sin[\[Theta]] \[ScriptD][\[CurlyPhi]]), -\[ScriptD]r^2 + \[ScriptD][t]^2 - 
    2 b^2 \[ScriptD][\[Theta]]^2 - 2 b^2 
    Sin[\[Theta]]^2 \[ScriptD][\[CurlyPhi]]^2, 
