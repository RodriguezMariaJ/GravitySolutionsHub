Cell[CellGroupData[{

Cell["\<\
 Example 0: Flat spacetime in rotating prolate spheroidal coordinates\
\>", "Subsection",
 ShowGroupOpener->True,
 FontSize->16],

Cell[TextData[{
 StyleBox["\t",
  FontWeight->"Bold"],
 "Transform the flat line element from cylindrical coordinates (\[Rho], z, \
phi) to (\[Lambda], \[Mu], \[Phi]), where ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox["\[Rho]", "2"], "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Lambda]", "2"], "-", "1"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["\[Mu]", "2"]}], ")"}]}]}], ",", " ", 
   RowBox[{"z", "=", 
    RowBox[{"\[Lambda]", " ", "\[Mu]"}]}], ",", " ", 
   RowBox[{"phi", "=", 
    RowBox[{"\[Phi]", "+", 
     RowBox[{"\[CapitalOmega]", " ", "t"}]}]}]}]]],
 ":"
}], "Text",
 FontSize->16,
 FontColor->RGBColor[0, 0, 1]],

Cell[BoxData[
 RowBox[{
  RowBox[{"xCoord", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "\[CurlyPhi]", ",", "\[Lambda]", ",", "\[Mu]"}], 
    "}"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"gFLAT", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "-", 
        RowBox[{
         RowBox[{"\[CapitalOmega]", "^", "2"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Lambda]", "^", "2"}], "-", "1"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}]}], ",", 
       RowBox[{
        RowBox[{"-", "\[CapitalOmega]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Lambda]", "^", "2"}], "-", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}], ",", "0", ",", "0"}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[CapitalOmega]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Lambda]", "^", "2"}], "-", "1"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}], ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Lambda]", "^", "2"}], "-", "1"}], ")"}]}], 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}], ",", "0", ",", "0"}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Lambda]", "^", "2"}], "-", 
           RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[Lambda]", "^", "2"}], "-", "1"}], ")"}]}], ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[Lambda]", "^", "2"}], "-", 
           RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"\[Mu]", "^", "2"}]}], ")"}]}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RGtensors", "[", 
  RowBox[{"gFLAT", ",", "xCoord"}], "]"}]], "Input"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"gdd = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", GridBox[{
       {
        RowBox[{"1", "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Lambda]", "2"]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox["\[Mu]", "2"]}], ")"}], " ", 
          SuperscriptBox["\[CapitalOmega]", "2"]}]}], 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Lambda]", "2"]}], ")"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["\[Mu]", "2"]}], ")"}], " ", "\[CapitalOmega]"}], 
        "0", "0"},
       {
        RowBox[{
         RowBox[{"-", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Lambda]", "2"]}], ")"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["\[Mu]", "2"]}], ")"}], " ", "\[CapitalOmega]"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["\[Lambda]", "2"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "-", 
           SuperscriptBox["\[Mu]", "2"]}], ")"}]}], "0", "0"},
       {"0", "0", 
        FractionBox[
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["\[Lambda]", "2"]}], "+", 
          SuperscriptBox["\[Mu]", "2"]}], 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[Lambda]", "2"]}]], "0"},
       {"0", "0", "0", 
        FractionBox[
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["\[Lambda]", "2"]}], "+", 
          SuperscriptBox["\[Mu]", "2"]}], 
         RowBox[{"1", "-", 
          SuperscriptBox["\[Mu]", "2"]}]]}
      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gdd = ", 
   MatrixForm[{{
     1 - (-1 + \[Lambda]^2) (
       1 - \[Mu]^2) \[CapitalOmega]^2, -(-1 + \[Lambda]^2) (
       1 - \[Mu]^2) \[CapitalOmega], 0, 
      0}, {-(-1 + \[Lambda]^2) (1 - \[Mu]^2) \[CapitalOmega], (
       1 - \[Lambda]^2) (1 - \[Mu]^2), 0, 0}, {
     0, 0, (-1 + \[Lambda]^2)^(-1) (-\[Lambda]^2 + \[Mu]^2), 0}, {
     0, 0, 0, (1 - \[Mu]^2)^(-1) (-\[Lambda]^2 + \[Mu]^2)}}]],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"LineElement = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SuperscriptBox["\[CapitalOmega]", "2"], "-", 
        RowBox[{
         SuperscriptBox["\[Lambda]", "2"], " ", 
         SuperscriptBox["\[CapitalOmega]", "2"]}], "-", 
        RowBox[{
         SuperscriptBox["\[Mu]", "2"], " ", 
         SuperscriptBox["\[CapitalOmega]", "2"]}], "+", 
        RowBox[{
         SuperscriptBox["\[Lambda]", "2"], " ", 
         SuperscriptBox["\[Mu]", "2"], " ", 
         SuperscriptBox["\[CapitalOmega]", "2"]}]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{"d", "[", "t", "]"}], "2"]}], "-", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[Lambda]", "2"], "-", 
         SuperscriptBox["\[Mu]", "2"]}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "\[Lambda]", "]"}], "2"]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[Lambda]", "2"]}]], "-", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["\[Lambda]", "2"]}], "+", 
         SuperscriptBox["\[Mu]", "2"]}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "\[Mu]", "]"}], "2"]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["\[Mu]", "2"]}]], "+", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Lambda]", "2"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Mu]", "2"]}], ")"}], " ", "\[CapitalOmega]", " ", 
      RowBox[{"d", "[", "t", "]"}], " ", 
      RowBox[{"d", "[", "\[CurlyPhi]", "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Lambda]", "2"]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        SuperscriptBox["\[Mu]", "2"]}], ")"}], " ", 
      SuperscriptBox[
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}], "2"]}]}],
    Short[#, 32]& ]}],
  SequenceForm["LineElement = ", 
   Short[(
      1 + \[CapitalOmega]^2 - \[Lambda]^2 \[CapitalOmega]^2 - \[Mu]^2 \
\[CapitalOmega]^2 + \[Lambda]^2 \[Mu]^2 \[CapitalOmega]^2) 
     d[t]^2 - (-1 + \[Lambda]^2)^(-1) (\[Lambda]^2 - \[Mu]^2) 
    d[\[Lambda]]^2 - (-1 + \[Mu]^2)^(-1) (-\[Lambda]^2 + \[Mu]^2) d[\[Mu]]^2 + 
    2 (-1 + \[Lambda]^2) (-1 + \[Mu]^2) \[CapitalOmega] d[t] 
     d[\[CurlyPhi]] + (-1 + \[Lambda]^2) (-1 + \[Mu]^2) d[\[CurlyPhi]]^2, 32]],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"gUU = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", GridBox[{
       {"1", 
        RowBox[{"-", "\[CapitalOmega]"}], "0", "0"},
       {
        RowBox[{"-", "\[CapitalOmega]"}], 
        FractionBox[
         RowBox[{"1", "+", 
          SuperscriptBox["\[CapitalOmega]", "2"], "-", 
          RowBox[{
           SuperscriptBox["\[Lambda]", "2"], " ", 
           SuperscriptBox["\[CapitalOmega]", "2"]}], "-", 
          RowBox[{
           SuperscriptBox["\[Mu]", "2"], " ", 
           SuperscriptBox["\[CapitalOmega]", "2"]}], "+", 
          RowBox[{
           SuperscriptBox["\[Lambda]", "2"], " ", 
           SuperscriptBox["\[Mu]", "2"], " ", 
           SuperscriptBox["\[CapitalOmega]", "2"]}]}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Lambda]", "2"]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            SuperscriptBox["\[Mu]", "2"]}], ")"}]}]], "0", "0"},
       {"0", "0", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           SuperscriptBox["\[Lambda]", "2"]}], 
          RowBox[{
           SuperscriptBox["\[Lambda]", "2"], "-", 
           SuperscriptBox["\[Mu]", "2"]}]]}], "0"},
       {"0", "0", "0", 
        FractionBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          SuperscriptBox["\[Mu]", "2"]}], 
         RowBox[{
          SuperscriptBox["\[Lambda]", "2"], "-", 
          SuperscriptBox["\[Mu]", "2"]}]]}
      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gUU = ", 
   MatrixForm[{{
     1, -\[CapitalOmega], 0, 
      0}, {-\[CapitalOmega], (-1 + \[Lambda]^2)^(-1) (-1 + \[Mu]^2)^(-1) (
       1 + \[CapitalOmega]^2 - \[Lambda]^2 \[CapitalOmega]^2 - \[Mu]^2 \
\[CapitalOmega]^2 + \[Lambda]^2 \[Mu]^2 \[CapitalOmega]^2), 0, 0}, {
     0, 0, -(-1 + \[Lambda]^2)/(\[Lambda]^2 - \[Mu]^2), 0}, {
     0, 0, 0, (\[Lambda]^2 - \[Mu]^2)^(-1) (-1 + \[Mu]^2)}}]],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"gUU computed in \"\>", "\[InvisibleSpace]", 
   "0.0666666666666666518`", "\[InvisibleSpace]", "\<\" sec\"\>"}],
  SequenceForm["gUU computed in ", 0.06666666666666665, " sec"],
  Editable->False]], "Print"],

