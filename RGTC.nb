  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["EDCRGTCcode.m",
  FontFamily->"Courier",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox[" ",
  FontSize->16,
  FontWeight->"Bold"],
 StyleBox["in an appropriate directory. Also read subsection 4.0 before doing \
calculations with a new metric.",
  FontSize->16,
  FontWeight->"Bold"]
}], "Text",
 FontSize->18,
 FontColor->RGBColor[0, 0, 1]]
}, Open  ]],

