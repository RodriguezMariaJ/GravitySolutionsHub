   SuperscriptBox["y", "2"]}], "-", 
  SuperscriptBox["y", "3"], "+", 
  RowBox[{"6", " ", 
   SuperscriptBox["x", "2"], " ", 
   SuperscriptBox["y", "3"]}], "-", 
  RowBox[{"3", " ", 
   SuperscriptBox["x", "4"], " ", 
   SuperscriptBox["y", "3"]}], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], " ", 
   SuperscriptBox["y", "3"]}], "-", 
  RowBox[{"2", " ", "x", " ", 
   SuperscriptBox["y", "4"]}], "+", 
  RowBox[{"3", " ", 
   SuperscriptBox["x", "3"], " ", 
   SuperscriptBox["y", "4"]}], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], " ", 
   SuperscriptBox["y", "4"]}], "-", 
  RowBox[{
   SuperscriptBox["x", "2"], " ", 
   SuperscriptBox["y", "5"]}], "+", 
  RowBox[{
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], " ", 
   SuperscriptBox["y", "5"]}]}]], "Output"]
}, Open  ]],

