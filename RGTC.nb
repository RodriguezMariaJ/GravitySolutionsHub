        "0"},
       {
        RowBox[{
         SuperscriptBox["E", 
          RowBox[{"2", " ", 
           RowBox[{"\[Gamma]", "[", 
            RowBox[{"u", ",", "r", ",", "\[Theta]"}], "]"}]}]], " ", 
         SuperscriptBox["r", "2"], " ", 
         RowBox[{"U", "[", 
          RowBox[{"u", ",", "r", ",", "\[Theta]"}], "]"}]}], "0", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["E", 
           RowBox[{"2", " ", 
            RowBox[{"\[Gamma]", "[", 
             RowBox[{"u", ",", "r", ",", "\[Theta]"}], "]"}]}]]}], " ", 
         SuperscriptBox["r", "2"]}], "0"},
       {"0", "0", "0", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["E", 
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"\[Gamma]", "[", 
             RowBox[{"u", ",", "r", ",", "\[Theta]"}], "]"}]}]]}], " ", 
         SuperscriptBox["r", "2"], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gdd = ", 
   MatrixForm[{{-E^(2 \[Gamma][u, r, \[Theta]]) r^2 U[u, r, \[Theta]]^2 + 
      E^(2 \[Beta][u, r, \[Theta]]) r^(-1) V[u, r, \[Theta]], 
      E^(2 \[Beta][u, r, \[Theta]]), E^(2 \[Gamma][u, r, \[Theta]]) r^2 
      U[u, r, \[Theta]], 0}, {E^(2 \[Beta][u, r, \[Theta]]), 0, 0, 0}, {
     E^(2 \[Gamma][u, r, \[Theta]]) r^2 U[u, r, \[Theta]], 0, -
      E^(2 \[Gamma][u, r, \[Theta]]) r^2, 0}, {
     0, 0, 0, -E^((-2) \[Gamma][u, r, \[Theta]]) r^2 Sin[\[Theta]]^2}}]],
  Editable->False]], "Print"],

