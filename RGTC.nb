       4, 1]], ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     InterpretationBox[
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
