Cell[TextData[{
 "\t\[FilledSmallCircle] Construct the (rank-2) 2-form curvature tensor \
\[CapitalOmega]Ud with components \[CapitalOmega]Ud[[a,b]] =",
 Cell[BoxData[
  RowBox[{" ", 
   SubscriptBox[
    SuperscriptBox["\[CapitalOmega]", "a"], "b"]}]]],
 Cell[BoxData[
  RowBox[{"=", 
   RowBox[{
    FractionBox["1", "2"], 
    SubscriptBox[
     SuperscriptBox["R", "a"], "bcd"], 
    SuperscriptBox["e", "c"]}]}]]],
 Cell[BoxData[
  RowBox[{"\[Wedge]", 
   SuperscriptBox["e", "d"]}]]],
 "  (eUU is the 2-form-basis tensor: eUU[[a,b]]=e[a]\[Wedge]e[b])."
}], "Text",
 FontSize->16,
 FontColor->RGBColor[0, 0, 1]],

Cell[BoxData[
 RowBox[{
  RowBox[{"eUU", "=", 
   RowBox[{"Outer", "[", 
    RowBox[{"Wedge", ",", 
     RowBox[{"e", "/@", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}], ",", 
     RowBox[{"e", "/@", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}]}]}], "]"}]}], ";", 
  RowBox[{"Off", "[", 
   RowBox[{
    RowBox[{"General", "::", "\"\<spell\>\""}], ",", 
    RowBox[{"General", "::", "\"\<spell1\>\""}]}], "]"}], ";"}]], "Input",
 FontColor->GrayLevel[0.333333]],

