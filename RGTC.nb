Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RGtensors", "[", 
  RowBox[{"g", ",", "xCoord"}], "]"}]], "Input"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"gdd = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", GridBox[{
       {
        SuperscriptBox[
         RowBox[{"\[CapitalOmega]", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
         "2"], "0", "0", "0", "0"},
       {"0", 
        SuperscriptBox[
         RowBox[{"\[CapitalOmega]", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
         "2"], "0", "0", "0"},
       {"0", "0", 
        SuperscriptBox[
         RowBox[{"\[CapitalOmega]", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
         "2"], "0", "0"},
       {"0", "0", "0", 
        SuperscriptBox[
         RowBox[{"\[CapitalOmega]", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
         "2"], "0"},
       {"0", "0", "0", "0", 
        SuperscriptBox[
         RowBox[{"\[CapitalOmega]", "[", 
          RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
         "2"]}
      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gdd = ", 
   MatrixForm[{{\[CapitalOmega][x1, x2, x3, x4, x5]^2, 0, 0, 0, 0}, {
     0, \[CapitalOmega][x1, x2, x3, x4, x5]^2, 0, 0, 0}, {
     0, 0, \[CapitalOmega][x1, x2, x3, x4, x5]^2, 0, 0}, {
     0, 0, 0, \[CapitalOmega][x1, x2, x3, x4, x5]^2, 0}, {
     0, 0, 0, 0, \[CapitalOmega][x1, x2, x3, x4, x5]^2}}]],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"LineElement = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"d", "[", "x1", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"\[CapitalOmega]", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
       "2"]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"d", "[", "x2", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"\[CapitalOmega]", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
       "2"]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"d", "[", "x3", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"\[CapitalOmega]", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
       "2"]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"d", "[", "x4", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"\[CapitalOmega]", "[", 
        RowBox[{"x1", ",", "x2", ",", "x3", ",", "x4", ",", "x5"}], "]"}], 
       "2"]}], "+", 
     RowBox[{
      SuperscriptBox[
