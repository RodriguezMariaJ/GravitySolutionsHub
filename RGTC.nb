       RowBox[{"d", "[", "\[Theta]", "]"}], "2"]}], "-", 
     FractionBox[
      RowBox[{"4", " ", "a", " ", "M", " ", "r", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
       RowBox[{"d", "[", "u", "]"}], " ", 
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}]}], 
      RowBox[{
       SuperscriptBox["r", "2"], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          SuperscriptBox["a", "2"], " ", "M", " ", "r"}], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["r", "2"]}], "+", 
         SuperscriptBox["r", "4"], "+", 
         RowBox[{
          SuperscriptBox["a", "4"], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "-", 
         RowBox[{"2", " ", 
          SuperscriptBox["a", "2"], " ", "M", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["r", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "\[CurlyPhi]", "]"}], "2"]}], 
      RowBox[{
       SuperscriptBox["r", "2"], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]], "+", 
     RowBox[{
      RowBox[{"d", "[", "r", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"d", "[", "u", "]"}]}], "+", 
        RowBox[{"2", " ", "a", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Cos", "[", "\[Theta]", "]"}]}], ")"}], " ", 
         RowBox[{"d", "[", "\[CurlyPhi]", "]"}]}]}], ")"}]}]}],
    Short[#, 32]& ]}],
  SequenceForm["LineElement = ", 
   Short[-(2 M r - r^2 - a^2 
      Cos[\[Theta]]^2) (r^2 + a^2 Cos[\[Theta]]^2)^(-1) 
     d[u]^2 + (-r^2 - a^2 Cos[\[Theta]]^2) d[\[Theta]]^2 - 4 a M 
    r (-1 + Cos[\[Theta]]) (1 + 
     Cos[\[Theta]]) (r^2 + a^2 Cos[\[Theta]]^2)^(-1) d[u] 
    d[\[CurlyPhi]] + (-1 + Cos[\[Theta]]) (1 + 
      Cos[\[Theta]]) (r^2 + a^2 Cos[\[Theta]]^2)^(-1) (2 a^2 M r + a^2 r^2 + 
      r^4 + a^4 Cos[\[Theta]]^2 - 2 a^2 M r Cos[\[Theta]]^2 + 
      a^2 r^2 Cos[\[Theta]]^2) d[\[CurlyPhi]]^2 + 
    d[r] (2 d[u] + 
      2 a (-1 + Cos[\[Theta]]) (1 + Cos[\[Theta]]) d[\[CurlyPhi]]), 32]],
  Editable->False]], "Print"],

