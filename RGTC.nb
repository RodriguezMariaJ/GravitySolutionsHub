     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "y"}], ")"}], "^", "3"}]}], "+", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{"x", "^", "2"}]}], ")"}], "]"}], 
