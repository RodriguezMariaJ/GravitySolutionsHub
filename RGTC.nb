Cell[BoxData[
 RowBox[{
  RowBox[{"gSERb0", "[", "n_", "]"}], ":=", 
  RowBox[{"FacSimp", "[", 
   RowBox[{"Series", "[", 
    RowBox[{"gPERT", ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "0", ",", "n"}], "}"}]}], "]"}], "]"}]}]], "Input",
 FontColor->GrayLevel[0.333333]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gSERb0", "[", "3", "]"}]], "Input",
 FontColor->GrayLevel[0.333333]],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     InterpretationBox[
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          RowBox[{"2", " ", "m"}], "-", "r"}], "r"]}], "-", 
       FractionBox[
        RowBox[{"2", " ", "m", " ", 
         SuperscriptBox["b", "2"]}], 
        SuperscriptBox["r", "3"]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "4"],
        SeriesData[b, 0, {}, 0, 4, 1]]}],
      SeriesData[b, 0, {-(2 m - r)/r, 0, (-2) m r^(-3)}, 0, 4, 1]], ",", "0", 
     ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     InterpretationBox[
      RowBox[{
       FractionBox["r", 
        RowBox[{
         RowBox[{"2", " ", "m"}], "-", "r"}]], "-", 
       FractionBox[
        RowBox[{"2", " ", "m", " ", 
         SuperscriptBox["b", "2"]}], 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "m"}], "-", "r"}], ")"}], "2"], " ", "r"}]], 
       "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "4"],
        SeriesData[b, 0, {}, 0, 4, 1]]}],
      SeriesData[
      b, 0, {(2 m - r)^(-1) r, 0, (-2) m (2 m - r)^(-2)/r}, 0, 4, 1]], ",", 
     "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     InterpretationBox[
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["r", "2"]}], "+", 
       RowBox[{"2", " ", "r", " ", "b"}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["b", "2"]}], "+", 
       FractionBox[
        RowBox[{"4", " ", 
         SuperscriptBox["b", "3"]}], 
        RowBox[{"3", " ", "r"}]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "4"],
        SeriesData[b, 0, {}, 0, 4, 1]]}],
      SeriesData[b, 0, {-r^2, 2 r, -2, Rational[4, 3]/r}, 0, 4, 1]], ",", 
     "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", 
     InterpretationBox[
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         SuperscriptBox["r", "2"], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}], "-", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ")"}], " ", "b"}], 
       "-", 
       RowBox[{"2", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
        SuperscriptBox["b", "2"]}], "-", 
       FractionBox[
        RowBox[{"4", " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
