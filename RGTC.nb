     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ScriptD]", "[", "\[Theta]", "]"}], "-", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"\[ScriptD]", "[", "\[CurlyPhi]", "]"}]}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ScriptD]", "[", "\[Theta]", "]"}], "+", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"\[ScriptD]", "[", "\[CurlyPhi]", "]"}]}]}], ")"}]}], 
    FractionBox["1", "r"]], "+", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox["\[ScriptD]r", "2"]}], "+", 
     SuperscriptBox[
      RowBox[{"\[ScriptD]", "[", "t", "]"}], "2"], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["b", "2"], " ", 
      SuperscriptBox[
       RowBox[{"\[ScriptD]", "[", "\[Theta]", "]"}], "2"]}], "-", 
     RowBox[{"2", " ", 
      SuperscriptBox["b", "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"\[ScriptD]", "[", "\[CurlyPhi]", "]"}], "2"]}]}], ")"}], "-", 
   
   FractionBox[
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", "m", " ", 
        SuperscriptBox["\[ScriptD]r", "2"]}], "+", 
       RowBox[{"3", " ", "m", " ", 
        SuperscriptBox[
         RowBox[{"\[ScriptD]", "[", "t", "]"}], "2"]}], "-", 
       RowBox[{"2", " ", 
        SuperscriptBox["b", "3"], " ", 
        SuperscriptBox[
         RowBox[{"\[ScriptD]", "[", "\[Theta]", "]"}], "2"]}], "+", 
       RowBox[{"2", " ", 
        SuperscriptBox["b", "3"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
        SuperscriptBox[
         RowBox[{"\[ScriptD]", "[", "\[CurlyPhi]", "]"}], "2"]}]}], ")"}]}], 
    RowBox[{"3", " ", "r"}]], "-", 
   RowBox[{
    FractionBox["2", "3"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"6", " ", 
       SuperscriptBox["m", "2"], " ", 
       SuperscriptBox["\[ScriptD]r", "2"]}], "+", 
      RowBox[{
       SuperscriptBox["b", "4"], " ", 
       SuperscriptBox[
        RowBox[{"\[ScriptD]", "[", "\[Theta]", "]"}], "2"]}], "+", 
      RowBox[{
       SuperscriptBox["b", "4"], " ", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
       SuperscriptBox[
        RowBox[{"\[ScriptD]", "[", "\[CurlyPhi]", "]"}], "2"]}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", "r"], ")"}], "2"]}], "-", 
   RowBox[{
    FractionBox["2", "15"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"15", " ", 
       SuperscriptBox["b", "2"], " ", "m", " ", 
       SuperscriptBox["\[ScriptD]r", "2"]}], "+", 
      RowBox[{"60", " ", 
       SuperscriptBox["m", "3"], " ", 
       SuperscriptBox["\[ScriptD]r", "2"]}], "+", 
      RowBox[{"15", " ", 
       SuperscriptBox["b", "2"], " ", "m", " ", 
       SuperscriptBox[
        RowBox[{"\[ScriptD]", "[", "t", "]"}], "2"]}], "-", 
      RowBox[{"2", " ", 
       SuperscriptBox["b", "5"], " ", 
       SuperscriptBox[
        RowBox[{"\[ScriptD]", "[", "\[Theta]", "]"}], "2"]}], "+", 
      RowBox[{"2", " ", 
