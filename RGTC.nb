       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]], ",", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]], ",", 
     InterpretationBox[
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"m", "+", "r"}], ")"}], " ", "b"}], 
        SuperscriptBox["r", "4"]], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "m"}], "-", "r"}], ")"}], " ", 
         SuperscriptBox["b", "2"]}], 
        SuperscriptBox["r", "5"]], "+", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"9", " ", "m"}], "+", 
           RowBox[{"2", " ", "r"}]}], ")"}], " ", 
         SuperscriptBox["b", "3"]}], 
        RowBox[{"3", " ", 
         SuperscriptBox["r", "6"]}]], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"12", " ", "m"}], "-", "r"}], ")"}], " ", 
         SuperscriptBox["b", "4"]}], 
        RowBox[{"3", " ", 
         SuperscriptBox["r", "7"]}]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "5"],
        SeriesData[b, 0, {}, 1, 5, 1]]}],
      SeriesData[
      b, 0, {2 r^(-4) (m + r), (-2) (2 m - r) r^(-5), Rational[2, 3] 
        r^(-6) (9 m + 2 r), Rational[-2, 3] (12 m - r) r^(-7)}, 1, 5, 1]]}], 
    "}"}]}], "}"}]], "Output"]
}, Open  ]],

