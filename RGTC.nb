    RowBox[{"SymProd", "[", 
     RowBox[{"Zd", ",", "Zd"}], "]"}]}], "-", 
   RowBox[{
    RowBox[{"\[Lambda]", "[", "4", "]"}], "*", 
    RowBox[{"SymProd", "[", 
     RowBox[{"Ud", ",", "Ud"}], "]"}]}]}]}]], "Input"],

Cell[BoxData[
 RowBox[{"{", 
