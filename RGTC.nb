          RowBox[{"2", " ", "M", " ", "r"}], 
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox[
             RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]}], "1", "0", 
        FractionBox[
         RowBox[{"2", " ", "a", " ", "M", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]},
       {"1", "0", "0", 
        RowBox[{
         RowBox[{"-", "a"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]},
       {"0", "0", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["r", "2"]}], "-", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}], "0"},
       {
        FractionBox[
         RowBox[{"2", " ", "a", " ", "M", " ", "r", " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox[
            RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]], 
        RowBox[{
         RowBox[{"-", "a"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], "0", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              SuperscriptBox["a", "2"], " ", "M", " ", "r"}], "+", 
             RowBox[{
              SuperscriptBox["a", "2"], " ", 
              SuperscriptBox["r", "2"]}], "+", 
             SuperscriptBox["r", "4"], "+", 
             RowBox[{
              SuperscriptBox["a", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                SuperscriptBox["a", "2"], "-", 
                RowBox[{"2", " ", "M", " ", "r"}], "+", 
                SuperscriptBox["r", "2"]}], ")"}], " ", 
              SuperscriptBox[
               RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], 
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox[
             RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]}]]}]}
      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gdd = ", 
   MatrixForm[{{
     1 - 2 M r/(r^2 + a^2 Cos[\[Theta]]^2), 1, 0, 2 a M 
      r (r^2 + a^2 Cos[\[Theta]]^2)^(-1) Sin[\[Theta]]^2}, {
     1, 0, 0, -a Sin[\[Theta]]^2}, {0, 0, -r^2 - a^2 Cos[\[Theta]]^2, 0}, {
     2 a M r (r^2 + a^2 Cos[\[Theta]]^2)^(-1) Sin[\[Theta]]^2, -a 
      Sin[\[Theta]]^2, 
      0, -(r^2 + a^2 Cos[\[Theta]]^2)^(-1) (2 a^2 M r + a^2 r^2 + r^4 + 
       a^2 (a^2 - 2 M r + r^2) Cos[\[Theta]]^2) Sin[\[Theta]]^2}}]],
  Editable->False]], "Print"],

