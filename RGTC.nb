 "\tLet us consider a metric depending on a parameter b, which reduces to \
Schwarzschild when b=0:"
}], "Text",
 ShowGroupOpener->True,
 FontSize->16],

Cell[BoxData[
 RowBox[{
  RowBox[{"xCoord", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}]}], 
  ";", 
  RowBox[{"simpRules", "=", "TrigRules"}], ";"}]], "Input",
 FontColor->GrayLevel[0.333333]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", "r", "]"}], "=", 
   RowBox[{"1", "-", 
    RowBox[{"2", "m", "  ", 
     RowBox[{"r", "/", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"r", "^", "2"}], "-", 
        RowBox[{"b", "^", "2"}]}], ")"}]}]}]}]}], ";", 
  RowBox[{
   RowBox[{"B", "[", "r", "]"}], "=", 
   RowBox[{"Exp", "[", 
    RowBox[{"2", 
     RowBox[{"b", "/", "r"}]}], "]"}]}], ";"}]], "Input",
 FontColor->GrayLevel[0.333333]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"gPERT", "=", 
  RowBox[{"DiagonalMatrix", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"A", "[", "r", "]"}], ",", 
     RowBox[{
      RowBox[{"-", "1"}], "/", 
      RowBox[{"A", "[", "r", "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"r", "^", "2"}]}], "/", 
      RowBox[{"B", "[", "r", "]"}]}], ",", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"r", "^", "2"}]}], 
      RowBox[{"B", "[", "r", "]"}], 
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], "}"}], 
   "]"}]}]], "Input",
 FontColor->GrayLevel[0.333333]],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"2", " ", "m", " ", "r"}], 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["b", "2"]}], "+", 
        SuperscriptBox["r", "2"]}]]}], ",", "0", ",", "0", ",", "0"}], "}"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"1", "-", 
        FractionBox[
         RowBox[{"2", " ", "m", " ", "r"}], 
         RowBox[{
          RowBox[{"-", 
           SuperscriptBox["b", "2"]}], "+", 
          SuperscriptBox["r", "2"]}]]}]]}], ",", "0", ",", "0"}], "}"}], ",", 
   
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["E", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"2", " ", "b"}], "r"]}]]}], " ", 
