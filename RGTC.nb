Cell[BoxData[
 RowBox[{
  RowBox[{"rt3", "=", 
   RowBox[{"Sqrt", "[", "3", "]"}]}], ";", 
  RowBox[{"F1", "=", 
   RowBox[{
    RowBox[{"x", "/", "rt3"}], "-", 
    RowBox[{
     RowBox[{"t", "^", "2"}], "/", "12"}]}]}], " ", ";", 
  RowBox[{
   RowBox[{
    SuperscriptBox["F2", "\[Prime]",
     MultilineFunction->None], "[", "z", "]"}], "=", 
   RowBox[{
