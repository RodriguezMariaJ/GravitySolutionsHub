     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"d", "[", "u", "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["E", 
           RowBox[{"2", " ", 
            RowBox[{"\[Gamma]", "[", 
             RowBox[{"u", ",", "r", ",", "\[Theta]"}], "]"}]}]], " ", 
          SuperscriptBox["r", "3"], " ", 
          SuperscriptBox[
           RowBox[{"U", "[", 
            RowBox[{"u", ",", "r", ",", "\[Theta]"}], "]"}], "2"]}], "-", 
         RowBox[{
          SuperscriptBox["E", 
           RowBox[{"2", " ", 
            RowBox[{"\[Beta]", "[", 
             RowBox[{"u", ",", "r", ",", "\[Theta]"}], "]"}]}]], " ", 
          RowBox[{"V", "[", 
           RowBox[{"u", ",", "r", ",", "\[Theta]"}], "]"}]}]}], ")"}]}], 
      "r"]}],
    Short[#, 32]& ]}],
  SequenceForm["LineElement = ", 
   Short[2 E^(2 \[Beta][u, r, \[Theta]]) d[r] d[u] - 
