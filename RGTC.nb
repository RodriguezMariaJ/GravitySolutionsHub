Cell[CellGroupData[{

Cell[" Example 2: Robertson-Walker", "Subsection",
 ShowGroupOpener->True,
 FontSize->16],

Cell[BoxData[
 RowBox[{
  RowBox[{"xCoord", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"a", "[", "t", "]"}], "^", "2"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"k", " ", 
           RowBox[{"r", "^", "2"}]}]}], ")"}]}], ",", "0", ",", "0"}], "}"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"a", "[", "t", "]"}], "^", "2"}]}], 
        RowBox[{"r", "^", "2"}]}], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"r", "^", "2"}]}], 
        RowBox[{
         RowBox[{"a", "[", "t", "]"}], "^", "2"}], 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], "}"}]}], 
    "}"}]}], ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"simpRules", "=", "TrigRules"}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RGtensors", "[", 
  RowBox[{"g", ",", "xCoord"}], "]"}]], "Input"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"gdd = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", GridBox[{
       {"1", "0", "0", "0"},
       {"0", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"a", "[", "t", "]"}], "2"], 
          RowBox[{"1", "-", 
           RowBox[{"k", " ", 
            SuperscriptBox["r", "2"]}]}]]}], "0", "0"},
       {"0", "0", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["r", "2"]}], " ", 
         SuperscriptBox[
          RowBox[{"a", "[", "t", "]"}], "2"]}], "0"},
       {"0", "0", "0", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["r", "2"]}], " ", 
         SuperscriptBox[
          RowBox[{"a", "[", "t", "]"}], "2"], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gdd = ", 
   MatrixForm[{{1, 0, 0, 0}, {0, -(1 - k r^2)^(-1) a[t]^2, 0, 0}, {
     0, 0, -r^2 a[t]^2, 0}, {0, 0, 0, -r^2 a[t]^2 Sin[\[Theta]]^2}}]],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"LineElement = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"a", "[", "t", "]"}], "2"], " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "r", "]"}], "2"]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"k", " ", 
        SuperscriptBox["r", "2"]}]}]], "+", 
     SuperscriptBox[
      RowBox[{"d", "[", "t", "]"}], "2"], "-", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      SuperscriptBox[
       RowBox[{"a", "[", "t", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"d", "[", "\[Theta]", "]"}], "2"]}], "-", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      SuperscriptBox[
       RowBox[{"a", "[", "t", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}],
    Short[#, 32]& ]}],
  SequenceForm["LineElement = ", 
   Short[(-1 + k r^2)^(-1) a[t]^2 d[r]^2 + d[t]^2 - r^2 a[t]^2 d[\[Theta]]^2 - 
    r^2 a[t]^2 d[\[CurlyPhi]]^2 Sin[\[Theta]]^2, 32]],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"gUU = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", GridBox[{
       {"1", "0", "0", "0"},
       {"0", 
        FractionBox[
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"k", " ", 
           SuperscriptBox["r", "2"]}]}], 
         SuperscriptBox[
          RowBox[{"a", "[", "t", "]"}], "2"]], "0", "0"},
       {"0", "0", 
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{
           SuperscriptBox["r", "2"], " ", 
           SuperscriptBox[
            RowBox[{"a", "[", "t", "]"}], "2"]}]]}], "0"},
       {"0", "0", "0", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], 
          RowBox[{
           SuperscriptBox["r", "2"], " ", 
           SuperscriptBox[
            RowBox[{"a", "[", "t", "]"}], "2"]}]]}]}
      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gUU = ", 
   MatrixForm[{{1, 0, 0, 0}, {0, (-1 + k r^2) a[t]^(-2), 0, 0}, {
     0, 0, -r^(-2) a[t]^(-2), 0}, {
     0, 0, 0, -r^(-2) a[t]^(-2) Csc[\[Theta]]^2}}]],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"gUU computed in \"\>", "\[InvisibleSpace]", 
   "0.0333333333333332149`", "\[InvisibleSpace]", "\<\" sec\"\>"}],
  SequenceForm["gUU computed in ", 0.033333333333333215`, " sec"],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Gamma computed in \"\>", "\[InvisibleSpace]", 
   "0.0166666666666666074`", "\[InvisibleSpace]", "\<\" sec\"\>"}],
  SequenceForm["Gamma computed in ", 0.016666666666666607`, " sec"],
  Editable->False]], "Print"],

