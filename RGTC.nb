     RowBox[{"\[Lambda]", "[", "3", "]"}], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0", ",", 
     RowBox[{"-", 
      RowBox[{"\[Lambda]", "[", "4", "]"}]}]}], "}"}]}], "}"}]], "Output"]
}, Open  ]],

