   RowBox[{
    RowBox[{"2", 
     RowBox[{"d", "[", "u", "]"}], 
     RowBox[{"d", "[", "r", "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"2", 
        RowBox[{"M", "/", "r"}]}]}], ")"}], 
     RowBox[{
      RowBox[{"d", "[", "u", "]"}], "^", "2"}]}], "-", 
