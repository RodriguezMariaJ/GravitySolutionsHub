       RowBox[{"2", " ", "b", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["1", "r"], ")"}], "3"]}], "+", 
       RowBox[{"2", " ", "b", " ", 
        RowBox[{"(", 
         RowBox[{"b", "+", "m"}], ")"}], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox["1", "r"], ")"}], "4"]}], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", 
          FractionBox["1", "r"], "]"}], "5"],
        SeriesData[r, 
         DirectedInfinity[1], {}, 3, 5, 1]]}],
      SeriesData[r, 
       DirectedInfinity[1], {2 b, 2 b (b + m)}, 3, 5, 1]]}], "}"}]}], 
  "}"}]], "Output"]
}, Open  ]],

