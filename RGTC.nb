 "\t(5) The function ",
 StyleBox["indepCoefs",
  FontFamily->"Courier",
  FontWeight->"Bold"],
 StyleBox["[",
  FontFamily->"Courier"],
 StyleBox["x_",
  FontFamily->"Courier",
