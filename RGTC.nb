      SeriesData[b, 0, {}, 5, 5, 1]], ",", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]], ",", 
     InterpretationBox[
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"5", " ", "m"}], "-", "r"}], ")"}], " ", 
          SuperscriptBox["b", "2"]}], 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "m"}], "-", "r"}], ")"}], " ", 
          SuperscriptBox["r", "4"]}]]}], "-", 
       FractionBox[
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{"m", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"7", " ", "m"}], "-", 
             RowBox[{"5", " ", "r"}]}], ")"}]}], ")"}], " ", 
         SuperscriptBox["b", "4"]}], 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", " ", "m"}], "-", "r"}], ")"}], "2"], " ", 
         SuperscriptBox["r", "6"]}]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "5"],
        SeriesData[b, 0, {}, 2, 5, 1]]}],
      SeriesData[
      b, 0, {(-2) (2 m - r)^(-1) (5 m - r) r^(-4), 0, (-4) 
        m (7 m - 5 r) (2 m - r)^(-2) r^(-6)}, 2, 5, 1]], ",", 
     InterpretationBox[
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"Cot", "[", "\[Theta]", "]"}], " ", "b"}], 
        SuperscriptBox["r", "2"]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "5"],
        SeriesData[b, 0, {}, 1, 5, 1]]}],
      SeriesData[b, 0, {2 r^(-2) Cot[\[Theta]]}, 1, 5, 1]], ",", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]], ",", 
     InterpretationBox[
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"Cot", "[", "\[Theta]", "]"}], " ", "b"}], 
        SuperscriptBox["r", "2"]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "5"],
        SeriesData[b, 0, {}, 1, 5, 1]]}],
      SeriesData[b, 0, {2 r^(-2) Cot[\[Theta]]}, 1, 5, 1]], ",", 
     InterpretationBox[
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", " ", 
          RowBox[{"(", 
           RowBox[{"m", "-", "r"}], ")"}], " ", "b"}], 
         SuperscriptBox["r", "2"]]}], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         SuperscriptBox["b", "2"]}], 
        SuperscriptBox["r", "2"]], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", "m"}], "-", 
           RowBox[{"2", " ", "r"}]}], ")"}], " ", 
         SuperscriptBox["b", "3"]}], 
        RowBox[{"3", " ", 
         SuperscriptBox["r", "4"]}]], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", " ", "m"}], "+", "r"}], ")"}], " ", 
         SuperscriptBox["b", "4"]}], 
        RowBox[{"3", " ", 
         SuperscriptBox["r", "5"]}]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "5"],
        SeriesData[b, 0, {}, 1, 5, 1]]}],
      SeriesData[
      b, 0, {(-2) (m - r) r^(-2), (-2) r^(-2), Rational[-2, 3] (3 m - 2 r) 
        r^(-4), Rational[-2, 3] r^(-5) (2 m + r)}, 1, 5, 1]], ",", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]], ",", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]], ",", 
     InterpretationBox[
      SuperscriptBox[
       RowBox[{"O", "[", "b", "]"}], "5"],
      SeriesData[b, 0, {}, 5, 5, 1]], ",", 
     InterpretationBox[
      RowBox[{
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{"m", "+", "r"}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", "b"}], 
        SuperscriptBox["r", "2"]], "+", 
       FractionBox[
        RowBox[{"6", " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
         SuperscriptBox["b", "2"]}], 
        SuperscriptBox["r", "2"]], "+", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"3", " ", "m"}], "+", 
           RowBox[{"14", " ", "r"}]}], ")"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], " ", 
         SuperscriptBox["b", "3"]}], 
        RowBox[{"3", " ", 
         SuperscriptBox["r", "4"]}]], "-", 
       FractionBox[
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", "m"}], "-", 
             RowBox[{"15", " ", "r"}]}], ")"}], " ", 
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ")"}], " ", 
         SuperscriptBox["b", "4"]}], 
        RowBox[{"3", " ", 
         SuperscriptBox["r", "5"]}]], "+", 
       InterpretationBox[
        SuperscriptBox[
         RowBox[{"O", "[", "b", "]"}], "5"],
        SeriesData[b, 0, {}, 1, 5, 1]]}],
      SeriesData[
      b, 0, {2 r^(-2) (m + r) Sin[\[Theta]]^2, 6 r^(-2) Sin[\[Theta]]^2, 
        Rational[2, 3] r^(-4) (3 m + 14 r) Sin[\[Theta]]^2, 
        Rational[-2, 3] (2 m - 15 r) r^(-5) Sin[\[Theta]]^2}, 1, 5, 1]]}], 
    "}"}]}], "}"}]], "Output"]
}, Open  ]],

