            FontFamily->"Courier"], "/", 
           RowBox[{"(", 
            RowBox[{"Sigma", "-", 
             RowBox[{"2", "M", " ", "r"}]}], ")"}]}]}], "]"}]}], "}"}], "]"}],
      "]"}], ".", "coFrame"}], "]"}]}]], "Input",
 FontColor->GrayLevel[0.333333]],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox[
     RowBox[{
      SqrtBox[
