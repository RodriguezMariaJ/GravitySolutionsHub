            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["x", "2"]}]}]], "-", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", "M", " ", "r"}], "+", 
           SuperscriptBox["r", "2"], "+", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["x", "2"]}]}]]}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         SqrtBox[
          RowBox[{
           SuperscriptBox["r", "2"], "+", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["x", "2"]}]}]], "+", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"-", "2"}], " ", "M", " ", "r"}], "+", 
           SuperscriptBox["r", "2"], "+", 
           RowBox[{
            SuperscriptBox["a", "2"], " ", 
            SuperscriptBox["x", "2"]}]}]]}], ")"}]}], "->", 
      RowBox[{"2", " ", "M", " ", "r"}]}]}], "}"}]}], ";"}]], "Input",
 FontColor->GrayLevel[0.333333]],

