Cell[TextData[{
 "\t\[FilledSmallCircle] Verify that  ",
 Cell[BoxData[
  SubscriptBox[
   SuperscriptBox["\[CapitalOmega]", "a"], "b"]]],
 " equals  d[",
 Cell[BoxData[
  SubscriptBox[
   SuperscriptBox["\[Omega]", "a"], "b"]]],
 "]+",
 Cell[BoxData[
  SubscriptBox[
   SuperscriptBox["\[Omega]", "a"], "s"]]],
 "\[Wedge]",
 Cell[BoxData[
  SubscriptBox[
   SuperscriptBox["\[Omega]", "s"], "b"]]],
 ". (Wedge multiplication of tensors acts like ",
 StyleBox["Dot",
  FontFamily->"Courier"],
 " - contracts last index of first tensor with first index of second \
tensor)."
}], "Text",
 FontSize->16,
 FontColor->RGBColor[0, 0, 1]],

