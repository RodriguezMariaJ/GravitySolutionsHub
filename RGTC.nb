     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "x"}], ")"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], "/", 
        SqrtBox[
         RowBox[{"1", "-", 
          SuperscriptBox["x", "2"]}]]}]}], "->", 
      RowBox[{"-", 
       SqrtBox[
        RowBox[{"1", "-", 
         SuperscriptBox["x", "2"]}]]}]}], ",", 
     RowBox[{
