     RowBox[{
      RowBox[{"f1", "[", 
       RowBox[{"r", "-", "t"}], "]"}], "+", 
      RowBox[{"f2", "[", 
       RowBox[{"r", "+", "t"}], "]"}]}], "r"]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["U", 
      TagBox[
       RowBox[{"(", 
        RowBox[{"0", ",", "1"}], ")"}],
       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"t", ",", "r"}], "]"}], "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"f1", "[", 
        RowBox[{"r", "-", "t"}], "]"}], 
       SuperscriptBox["r", "2"]]}], "-", 
     FractionBox[
      RowBox[{"f2", "[", 
       RowBox[{"r", "+", "t"}], "]"}], 
      SuperscriptBox["r", "2"]], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["f1", "\[Prime]",
        MultilineFunction->None], "[", 
       RowBox[{"r", "-", "t"}], "]"}], "r"], "+", 
     FractionBox[
      RowBox[{
       SuperscriptBox["f2", "\[Prime]",
        MultilineFunction->None], "[", 
       RowBox[{"r", "+", "t"}], "]"}], "r"]}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["U", 
      TagBox[
       RowBox[{"(", 
