Cell[BoxData[
 RowBox[{"RGtensors", "[", 
  RowBox[{"g", ",", "xCoord"}], "]"}]], "Input"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"gdd = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{"(", GridBox[{
       {
        RowBox[{"1", "-", 
         FractionBox[
          RowBox[{"2", " ", "M"}], "r"]}], "0", "0", "0"},
       {"0", 
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{"1", "-", 
           FractionBox[
            RowBox[{"2", " ", "M"}], "r"]}]]}], "0", "0"},
       {"0", "0", 
        RowBox[{"-", 
         SuperscriptBox["r", "2"]}], "0"},
       {"0", "0", "0", 
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["r", "2"]}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}
      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gdd = ", 
   MatrixForm[{{1 - 2 M/r, 0, 0, 0}, {0, (-1)/(1 - 2 M/r), 0, 0}, {
     0, 0, -r^2, 0}, {0, 0, 0, -r^2 Sin[\[Theta]]^2}}]],
  Editable->False]], "Print"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"LineElement = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{
     FractionBox[
      RowBox[{"r", " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "r", "]"}], "2"]}], 
      RowBox[{
       RowBox[{"2", " ", "M"}], "-", "r"}]], "-", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "M"}], "-", "r"}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "t", "]"}], "2"]}], "r"], "-", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      SuperscriptBox[
       RowBox[{"d", "[", "\[Theta]", "]"}], "2"]}], "-", 
     RowBox[{
      SuperscriptBox["r", "2"], " ", 
      SuperscriptBox[
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}]}],
    Short[#, 32]& ]}],
  SequenceForm["LineElement = ", 
   Short[(2 M - r)^(-1) r d[r]^2 - (2 M - r) r^(-1) d[t]^2 - r^2 
    d[\[Theta]]^2 - r^2 d[\[CurlyPhi]]^2 Sin[\[Theta]]^2, 32]],
  Editable->False]], "Print"],

