     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"b", "[", 
          RowBox[{"m", ",", "k"}], "]"}], "/", 
         RowBox[{"x", "^", "m"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", 
