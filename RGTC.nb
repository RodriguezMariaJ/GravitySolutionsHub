            RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ")"}]}], 
        FractionBox["1", "r"]], "-", 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["b", "2"], " ", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"]}], ")"}]}], "-", 
       FractionBox[
