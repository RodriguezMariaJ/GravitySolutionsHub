Cell[BoxData["\<\"OK\"\>"], "Print"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"d", "[", "m", "]"}], "=", "0"}], ";", 
  RowBox[{
   RowBox[{"d", "[", "a", "]"}], "=", "0"}], ";", 
  RowBox[{
   RowBox[{"d", "[", "b", "]"}], "=", "0"}], ";"}]], "Input",
 FontColor->GrayLevel[0.333333]],

Cell[BoxData[
 RowBox[{
  RowBox[{"ONframe", "=", 
   RowBox[{"PowerExpand", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"A", "[", "r", "]"}], "]"}], 
       RowBox[{"d", "[", "t", "]"}]}], ",", 
      RowBox[{
       RowBox[{"d", "[", "r", "]"}], "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"A", "[", "r", "]"}], "]"}]}], ",", 
      RowBox[{"r", " ", 
       RowBox[{
        RowBox[{"d", "[", "\[Theta]", "]"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"B", "[", "r", "]"}], "]"}]}]}], ",", 
      RowBox[{"r", " ", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], 
       RowBox[{"Sqrt", "[", 
        RowBox[{"B", "[", "r", "]"}], "]"}], 
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}]}]}], "}"}], "]"}]}], 
  ";"}]], "Input",
 FontColor->GrayLevel[0.333333]],

Cell[BoxData[
 RowBox[{
  RowBox[{"gON", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], "]"}]}], ";"}]], "Input",
 FontColor->GrayLevel[0.333333]],

