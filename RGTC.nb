      }], ")"}],
    MatrixForm[#]& ]}],
  SequenceForm["gUU = ", 
   MatrixForm[{{
     a^2 (-1 + Cos[\[Theta]]) (1 + Cos[\[Theta]])/(r^2 + 
      a^2 Cos[\[Theta]]^2), (a^2 + r^2)/(r^2 + a^2 Cos[\[Theta]]^2), 0, -a/(
      r^2 + a^2 Cos[\[Theta]]^2)}, {(a^2 + r^2)/(r^2 + 
      a^2 Cos[\[Theta]]^2), -(a^2 - 2 M r + r^2)/(r^2 + a^2 Cos[\[Theta]]^2), 
      0, a/(r^2 + a^2 Cos[\[Theta]]^2)}, {
     0, 0, (-1)/(r^2 + a^2 Cos[\[Theta]]^2), 0}, {-a/(r^2 + 
      a^2 Cos[\[Theta]]^2), a/(r^2 + a^2 Cos[\[Theta]]^2), 
      0, (-1 + Cos[\[Theta]])^(-1) (1 + Cos[\[Theta]])^(-1)/(r^2 + 
      a^2 Cos[\[Theta]]^2)}}]],
  Editable->False]], "Print"],

