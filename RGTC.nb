Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"LineElement = \"\>", "\[InvisibleSpace]", 
   TagBox[
    RowBox[{
     FractionBox[
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["r", "2"], "+", 
          RowBox[{
           SuperscriptBox["a", "2"], " ", 
           SuperscriptBox["x", "2"]}]}], ")"}], " ", 
        SuperscriptBox[
         RowBox[{"d", "[", "r", "]"}], "2"]}]}], 
      RowBox[{
       SuperscriptBox["a", "2"], "-", 
       RowBox[{"2", " ", "M", " ", "r"}], "+", 
       SuperscriptBox["r", "2"]}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "M", " ", "r"}], "+", 
         SuperscriptBox["r", "2"], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["x", "2"]}]}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "t", "]"}], "2"]}], 
      RowBox[{
       SuperscriptBox["r", "2"], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["x", "2"]}]}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["r", "2"], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["x", "2"]}]}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "x", "]"}], "2"]}], 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["x", "2"]}]], "-", 
     FractionBox[
      RowBox[{"4", " ", "a", " ", "M", " ", "r", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["x", "2"]}], ")"}], " ", 
       RowBox[{"d", "[", "t", "]"}], " ", 
       RowBox[{"d", "[", "\[CurlyPhi]", "]"}]}], 
      RowBox[{
       SuperscriptBox["r", "2"], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["x", "2"]}]}]], "+", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SuperscriptBox["x", "2"]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          SuperscriptBox["a", "2"], " ", "M", " ", "r"}], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["r", "2"]}], "+", 
         SuperscriptBox["r", "4"], "+", 
         RowBox[{
          SuperscriptBox["a", "4"], " ", 
          SuperscriptBox["x", "2"]}], "-", 
         RowBox[{"2", " ", 
          SuperscriptBox["a", "2"], " ", "M", " ", "r", " ", 
          SuperscriptBox["x", "2"]}], "+", 
         RowBox[{
          SuperscriptBox["a", "2"], " ", 
          SuperscriptBox["r", "2"], " ", 
          SuperscriptBox["x", "2"]}]}], ")"}], " ", 
       SuperscriptBox[
        RowBox[{"d", "[", "\[CurlyPhi]", "]"}], "2"]}], 
      RowBox[{
       SuperscriptBox["r", "2"], "+", 
       RowBox[{
        SuperscriptBox["a", "2"], " ", 
        SuperscriptBox["x", "2"]}]}]]}],
    Short[#, 32]& ]}],
  SequenceForm["LineElement = ", 
   Short[-(a^2 - 2 M r + r^2)^(-1) (r^2 + a^2 x^2) 
     d[r]^2 + (r^2 + a^2 x^2)^(-1) ((-2) M r + r^2 + a^2 x^2) 
     d[t]^2 + (-1 + x^2)^(-1) (r^2 + a^2 x^2) d[x]^2 - 4 a M 
    r (-1 + x^2) (r^2 + a^2 x^2)^(-1) d[t] 
    d[\[CurlyPhi]] + (-1 + x^2) (r^2 + a^2 x^2)^(-1) (2 a^2 M r + a^2 r^2 + 
      r^4 + a^4 x^2 - 2 a^2 M r x^2 + a^2 r^2 x^2) d[\[CurlyPhi]]^2, 32]],
  Editable->False]], "Print"],

