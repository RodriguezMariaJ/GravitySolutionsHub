Cell[BoxData[
 InterpretationBox[
  RowBox[{
   RowBox[{"e", "[", "2", "]"}], "-", 
   FractionBox[
    RowBox[{"m", " ", 
     RowBox[{"e", "[", "2", "]"}]}], "r"], "-", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["m", "2"], " ", 
      RowBox[{"e", "[", "2", "]"}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", "r"], ")"}], "2"]}], "-", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{"m", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         SuperscriptBox["b", "2"]}], "+", 
        SuperscriptBox["m", "2"]}], ")"}], " ", 
      RowBox[{"e", "[", "2", "]"}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", "r"], ")"}], "3"]}], "-", 
   RowBox[{
    FractionBox["1", "8"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["m", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"8", " ", 
         SuperscriptBox["b", "2"]}], "+", 
        RowBox[{"5", " ", 
         SuperscriptBox["m", "2"]}]}], ")"}], " ", 
      RowBox[{"e", "[", "2", "]"}]}], ")"}], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", "r"], ")"}], "4"]}], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", 
      FractionBox["1", "r"], "]"}], "5"],
    SeriesData[r, 
     DirectedInfinity[1], {}, 0, 5, 1]]}],
  SeriesData[r, 
   DirectedInfinity[1], {
    e[2], -m e[2], Rational[-1, 2] m^2 e[2], Rational[-1, 2] m (2 b^2 + m^2) 
    e[2], Rational[-1, 8] m^2 (8 b^2 + 5 m^2) e[2]}, 0, 5, 1]]], "Output"]
}, Open  ]],

