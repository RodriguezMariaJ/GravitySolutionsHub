 RowBox[{
  RowBox[{"SS0", "=", 
   RowBox[{"SS", "-", 
    RowBox[{
     RowBox[{
      RowBox[{"tr", "[", 
       RowBox[{"SS", ".", "gUU"}], "]"}], "/", "4"}], "gdd"}]}]}], 
  ";"}]], "Input"],

