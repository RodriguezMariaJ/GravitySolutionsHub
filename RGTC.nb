Cell[" Example 1: Schwarzschild", "Subsection",
 ShowGroupOpener->True,
 FontSize->16],

Cell[BoxData[
 RowBox[{
  RowBox[{"xCoord", "=", 
   RowBox[{"{", 
    RowBox[{"t", ",", "r", ",", "\[Theta]", ",", "\[CurlyPhi]"}], "}"}]}], 
  ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "-", 
       RowBox[{"2", 
        RowBox[{"M", "/", "r"}]}]}], ",", 
      RowBox[{
       RowBox[{"-", "1"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", 
          RowBox[{"M", "/", "r"}]}]}], ")"}]}], ",", 
      RowBox[{"-", 
       RowBox[{"r", "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"r", "^", "2"}]}], 
       RowBox[{
        RowBox[{"Sin", "[", "\[Theta]", "]"}], "^", "2"}]}]}], "}"}], "]"}]}],
   ";"}]], "Input"],

Cell[BoxData[
 RowBox[{
  RowBox[{"simpRules", "=", "TrigRules"}], ";"}]], "Input"],

Cell[TextData[{
 "\t",
 StyleBox["TrigRules are predefined rules to implement the identities ",
  FontSize->16],
 Cell[BoxData[
  StyleBox[
   SuperscriptBox[
    RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"],
   FontSize->14]]],
 " ",
 StyleBox["+",
  FontSize->16],
 Cell[BoxData[
  RowBox[{" ", 
   StyleBox[
    SuperscriptBox[
     RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"],
    FontSize->14]}]]],
 StyleBox["=1 and ",
  FontSize->16],
 Cell[BoxData[
  RowBox[{
   StyleBox[
    SuperscriptBox[
     RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"],
    FontSize->14], " "}]]],
 StyleBox["- ",
  FontSize->16],
 Cell[BoxData[
  SuperscriptBox[
   RowBox[{"Cot", "[", "\[Theta]", "]"}], "2"]],
  FontSize->14],
 StyleBox["=1.",
  FontSize->16]
}], "Text",
 FontColor->RGBColor[0, 0, 1]],

