       Derivative],
      MultilineFunction->None], "[", 
     RowBox[{"t", ",", "r"}], "]"}], "\[Rule]", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"f1", "[", 
        RowBox[{"r", "-", "t"}], "]"}]}], 
      SuperscriptBox["r", "3"]], "+", 
     FractionBox[
      RowBox[{"2", " ", 
